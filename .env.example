# Leave both blank for device-only demo storage.
# To use local Supabase: npx supabase start, then copy the publishable key from npx supabase status.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public pk. Mapbox token for route generation and recorded-road matching (never an sk. secret).
# app.config.ts exposes this public token to the app. Restart Metro after changing it.
MAPBOX_ACCESS_TOKEN=
