{
  "expo": {
    "name": "Karla Drive",
    "slug": "karla-drive-prototype",
    "scheme": "karla-drive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/koala-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karladrive.prototype",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.karladrive.prototype",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/koala-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "c67d829b-b23f-453a-bc39-9f74b6db6a97"
      }
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-router"
    ]
  }
}
